datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Client {
  id          String         @id @default(uuid())
  name        String
  taxId       String
  npiNumber   String?
  phone       String?
  email       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  status      String         @default("ACTIVE")
  specialty   String?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  vendors     ClientVendor[]
  history     ChangeHistory[]
  contacts    Contact[]
  billingEnrollments ClientBillingEnrollment[]
}

model Vendor {
  id          String         @id @default(uuid())
  name        String
  taxId       String
  phone       String?
  email       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  vendorType  String         @default("GENERAL")
  status      String         @default("ACTIVE")
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  clients     ClientVendor[]
  history     ChangeHistory[]
  contacts    Contact[]
}

model ClientVendor {
  id         String   @id @default(uuid())
  clientId   String
  vendorId   String
  assignedAt DateTime @default(now())
  notes      String?
  fee        String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([clientId, vendorId])
  @@index([clientId])
  @@index([vendorId])
}

model ChangeHistory {
  id          String   @id @default(uuid())
  entityType  String   // "CLIENT" | "VENDOR"
  entityId    String
  action      String   // "CREATE" | "UPDATE" | "STATUS_CHANGE" | "ASSOCIATION_ADDED" | "ASSOCIATION_REMOVED"
  summary     String
  changes     String?  // JSON stringified array: [{ field, oldValue, newValue }]
  snapshot    String?  // JSON stringified state snapshot of the profile at this version
  createdAt   DateTime @default(now())

  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vendorId    String?
  vendor      Vendor?  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([clientId])
  @@index([vendorId])
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  title     String?
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vendorId  String?
  vendor    Vendor?  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([vendorId])
}

model ClientBillingEnrollment {
  id                                  String   @id @default(uuid())
  clientId                            String
  client                              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Plan Year & Dates
  planYear                            String   @default("2026")
  startDate                           String?
  endDate                             String?
  isCurrent                           Boolean  @default(true)

  // Carrier & Underwriter Info
  currentStopLossCarrier              String?
  currentManagingGeneralUnderwriter   String?
  priorStopLossCarrier                String?
  priorManagingGeneralUnderwriter     String?

  // Specific Stop-Loss Information
  specificDeductible                  String?
  aggregatingSpecificDeductible       String?
  noLaserRenewalGuarantee            String?
  maxSpecificPremiumRenewalIncrease   String?
  laseredIndividuals                  String?
  specificTierStructure               String?
  specificPremiumSingle               String?
  specificPremiumEmployeePlusOne      String?
  specificPremiumEmployeeSpouse       String?
  specificPremiumEmployeeChildren     String?
  specificPremiumFamily               String?
  specificBenefitsCovered             String?
  specificContract                    String?

  // Aggregate Stop-Loss Information
  aggregateStopLossStatus             String?  @default("Included")
  aggregatePremium                    String?
  monthlyAggregateAccommodation       String?
  aggregateFactorSingle               String?
  aggregateFactorEmployeePlusOne      String?
  aggregateFactorFamily               String?
  aggregateMinAttachmentPoint         String?
  aggregateBenefitsCovered            String?
  aggregateContract                   String?
  aggregateRunInLimit                 String?

  // Organ Transplant Policy Information
  organTransplantPolicy               String?

  // Composite Administration & PPO Network Information
  compositeAdminFee                   String?
  medicalFee                          String?
  urFee                               String?
  amwellFee                           String?
  physiciansCareHapFee                String?
  wrapNetwork                         String?
  aetnaSignatureAdminFee              String?
  networkAccessFee                    String?
  reinsuranceFee                      String?
  lcmSpaFee                           String?
  agentFee                            String?
  ppoFee                              String?

  // PBM Information
  pbmRx                               String?
  rxIncludedInAsrReporting            String?
  isRxAsrContract                     String?
  pbmAgentCompensation                String?

  // Commission Information
  stopLossCommission                  String?
  stopLossOtherCompensation           String?
  commissionAgentCompensation         String?

  // Enrollment Figures / Census
  figuresSingle                       String?
  figuresEmployeePlusOne              String?
  figuresFamily                       String?
  figuresTotal                        String?

  // General Notes & Domestic Claims
  domesticClaims                      String?
  notes                               String?
  stopLossNotes                       String?

  createdAt                           DateTime @default(now())
  updatedAt                           DateTime @updatedAt

  @@index([clientId])
}

